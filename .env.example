NEXT_PUBLIC_NEAR_NETWORK=mainnet
# Aggregate page counter (Umami Cloud, NH-111). Leave empty to load no analytics script at all.
# Create the site at cloud.umami.is, then set this to its website id — locally and in Vercel
# (Project → Settings → Environment Variables), and redeploy.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Per-listing view counts (NH-113). Upstash Redis over its REST API. The Vercel Marketplace
# integration injects UPSTASH_REDIS_REST_KV_REST_API_URL/_TOKEN automatically; Upstash's own
# console uses UPSTASH_REDIS_REST_URL/_TOKEN, and older Vercel KV uses KV_REST_API_URL/_TOKEN.
# All three are read. Without any of them /api/views reports available:false and no number shows.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# GitHub-checked project claims (NH-119). Create an OAuth App at github.com/settings/developers
# with the callback URL https://nearhunt.xyz/api/claim/callback (one app per origin: a preview or
# localhost needs its own app and callback). Set both here and in Vercel; the secret is server-only
# and must never get a NEXT_PUBLIC_ name. Claims also need the Upstash store above. Without all
# four, the project page shows no claim button.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Support page (NH-94/NH-121). NEXT_PUBLIC_STAKING_POOL is a validator staking pool account
# override; empty means avb.poolv1.near on mainnet (the owner's validator) and no card on testnet.
# NEXT_PUBLIC_DONATION_ACCOUNT moves direct donations to another account (a treasury); empty means
# nearhunt.near on mainnet. Both are read at build time: set them in Vercel and redeploy.
NEXT_PUBLIC_STAKING_POOL=
NEXT_PUBLIC_DONATION_ACCOUNT=
