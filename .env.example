NEXT_PUBLIC_NEAR_NETWORK=mainnet
# Aggregate page counter (Umami Cloud, NH-111). Leave empty to load no analytics script at all.
# Create the site at cloud.umami.is, then set this to its website id — locally and in Vercel
# (Project → Settings → Environment Variables), and redeploy.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Per-listing view counts (NH-113). Upstash Redis over its REST API; the Vercel Marketplace
# integration provisions both values (it may name them KV_REST_API_URL / KV_REST_API_TOKEN, which
# are read as aliases). Without them /api/views reports available:false and nothing is shown.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
