# dependencies
# bare form too: a symlink named node_modules is not a directory, so "node_modules/" misses it
node_modules
node_modules/
.pnp/
.pnp.js

# builds
dist/
build/
.next/
out/
target/

# env and secrets — never commit keys
.env
.env.*
!.env.example
*.pem
*.key
**/near-credentials/

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# logs
*.log
npm-debug.log*

# local scratch
tmp/
scratch/
docs/mockups/.tmp/

# raw X payloads and status pages fetched by the enrichment scripts (the proposal is committed)
data/enrichment/x-posts/
data/enrichment/x-threads/

# next.js / vercel (the project link carries project and org ids)
next-env.d.ts
*.tsbuildinfo
.vercel/

# agent worktrees (local only)
.claude/worktrees/

# AI judge notes: scores and rankings of other teams' projects. Kept local, never published
# (NH Picks shows recommendations only; see lib/picks.mjs).
data/judge-trends.md
data/shortlist-pass2.md
